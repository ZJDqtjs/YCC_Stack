.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid #e5e5e2;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.04);
}

.items {
  display: flex;
  height: 128rpx;
  align-items: center;
}

.item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.pill {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  transition: background 0.15s;
}

.item.on .pill {
  background: #f3f3f1;
}

.icon {
  width: 52rpx;
  height: 52rpx;
}

.label {
  font-size: 24rpx;
  line-height: 1.2;
  color: #8b8b88;
}

.item.on .label {
  color: #161616;
  font-weight: 600;
}

@media (prefers-color-scheme: dark) {
  .tabbar {
    background: rgba(19, 19, 21, 0.97);
    border-top-color: #262629;
    box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.35);
  }
  .item.on .pill {
    background: #1b1b1f;
  }
  .label {
    color: #86868a;
  }
  .item.on .label {
    color: #f3f3f2;
  }
}
